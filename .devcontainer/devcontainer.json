{
  "name": "Canvas API Python",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "postCreateCommand": "pip install -r requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "secrets": {
    "CANVAS_URL": {
      "description": "Canvas API Access Token"
    },
    "CANVAS_TOKEN": {
      "description": "Canvas Instance Base URL"
    },
    "COURSE_ID": {
      "description": "Additional required configuration secret"
    }
  }
}
